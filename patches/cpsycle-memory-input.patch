+	}
+	strncpy(self->szName, filename ? filename : "<memory>",
+		sizeof(self->szName) - 1);
+	self->szName[sizeof(self->szName) - 1] = '\0';
+	self->_file = NULL;
+	self->_memory = (const uint8_t*)data;
+	self->_memory_size = size;
+	self->_memory_pos = 0;
+	self->_memory_error = 0;
+	return 1;
+}
